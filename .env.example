# --- Frontend (baked in at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TOKEN=verdict-demo-token
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=

# --- Backend ---
API_TOKEN=verdict-demo-token
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///./verdict.db
AUTO_SEED=true

# PayPal: "mock" (default, clearly labeled) or "sandbox" (real calls where supported, sandbox only)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
WEBHOOK_SIM_SECRET=verdict-sim-secret

# LLM: "mock" (deterministic, offline) or "groq"
LLM_PROVIDER=mock
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_ADJUSTMENT_LIMIT=0.15

# Defaults for merchant limits (editable in Settings; stored per merchant)
AUTO_REFUND_CAP=100
APPROVAL_THRESHOLD=250
URGENT_HOURS=24
MODELED_MINUTES_PER_CASE=25

# Slows each pipeline stage so the live timeline is visible in a demo video (0 = full speed)
STAGE_DELAY_MS=0
